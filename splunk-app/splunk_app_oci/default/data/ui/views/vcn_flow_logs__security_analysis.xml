<form version="1.1" theme="dark">
  <label>VCN Flow Logs - Security Analysis</label>
  <description>Rejected/blocked VCN traffic from raw oci:log events (no summary index required).</description>
  <fieldset submitButton="false">
    <input type="time" token="tr">
      <label>Time range</label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="dropdown" token="proto" searchWhenChanged="true">
      <label>Protocol</label>
      <choice value="*">All</choice>
      <default>*</default>
      <fieldForLabel>protocolName</fieldForLabel>
      <fieldForValue>protocolName</fieldForValue>
      <search>
        <query>`oci_vcn_logs` `oci_trim` | stats count by protocolName</query>
        <earliest>$tr.earliest$</earliest>
        <latest>$tr.latest$</latest>
      </search>
    </input>
  </fieldset>
  <row>
    <panel>
      <single>
        <title>Rejected flows</title>
        <search>
          <query>`oci_vcn_logs` `oci_trim` | search action=REJECT protocolName="$proto$" | stats count</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0x53a051","0xdc4e41"]</option>
        <option name="rangeValues">[0]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Distinct rejected sources</title>
        <search>
          <query>`oci_vcn_logs` `oci_trim` | search action=REJECT protocolName="$proto$" | stats dc(sourceAddress)</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
      </single>
    </panel>
    <panel>
      <single>
        <title>Distinct targeted ports</title>
        <search>
          <query>`oci_vcn_logs` `oci_trim` | search action=REJECT protocolName="$proto$" | stats dc(destinationPort)</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
        <title>Rejected flows over time</title>
        <search>
          <query>`oci_vcn_logs` `oci_trim` | search action=REJECT protocolName="$proto$" | timechart count by protocolName useother=t</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.stackMode">stacked</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
        <title>Top rejected source addresses</title>
        <search>
          <query>`oci_vcn_logs` `oci_trim` | search action=REJECT protocolName="$proto$" | top limit=10 sourceAddress</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">bar</option>
      </chart>
    </panel>
    <panel>
      <chart>
        <title>Top targeted destination ports</title>
        <search>
          <query>`oci_vcn_logs` `oci_trim` | search action=REJECT protocolName="$proto$" | top limit=10 destinationPort</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">bar</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <table>
        <title>Recent rejected flows</title>
        <search>
          <query>`oci_vcn_logs` `oci_trim` | search action=REJECT protocolName="$proto$" | table _time sourceAddress sourcePort destinationAddress destinationPort protocolName packets | sort - _time</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="count">25</option>
      </table>
    </panel>
  </row>
</form>
