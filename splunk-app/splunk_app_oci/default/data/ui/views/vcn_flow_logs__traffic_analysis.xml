<form version="1.1" theme="dark">
  <label>VCN Flow Logs - Traffic Analysis</label>
  <description>VCN traffic volume and talkers from raw oci:log events (no summary index required).</description>
  <fieldset submitButton="false">
    <input type="time" token="tr">
      <label>Time range</label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>
  <row>
    <panel>
      <single>
        <title>Total flows</title>
        <search>
          <query>`oci_vcn_logs` `oci_trim` | stats count</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
      </single>
    </panel>
    <panel>
      <single>
        <title>Total bytes (out)</title>
        <search>
          <query>`oci_vcn_logs` `oci_trim` | stats sum(bytesOut) as bytes | eval bytes=tostring(bytes,"commas")</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
      </single>
    </panel>
    <panel>
      <single>
        <title>Total packets</title>
        <search>
          <query>`oci_vcn_logs` `oci_trim` | stats sum(packets) as packets | eval packets=tostring(packets,"commas")</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
        <title>Bytes over time by action</title>
        <search>
          <query>`oci_vcn_logs` `oci_trim` | timechart sum(bytesOut) as bytes by action</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">area</option>
        <option name="charting.chart.stackMode">stacked</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
        <title>Top talkers by bytes (source)</title>
        <search>
          <query>`oci_vcn_logs` `oci_trim` | stats sum(bytesOut) as bytes by sourceAddress | sort - bytes | head 10</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">bar</option>
      </chart>
    </panel>
    <panel>
      <chart>
        <title>Traffic by protocol</title>
        <search>
          <query>`oci_vcn_logs` `oci_trim` | stats count by protocolName | sort - count</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <table>
        <title>Top destinations by bytes</title>
        <search>
          <query>`oci_vcn_logs` `oci_trim` | stats sum(bytesOut) as bytes sum(packets) as packets count as flows by destinationAddress destinationPort | sort - bytes | head 25</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="count">25</option>
      </table>
    </panel>
  </row>
</form>
