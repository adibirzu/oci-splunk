receivers:
  kafka:
    brokers:
      - ${kafka_bootstrap_servers_json}
    group_id: ${soc4kafka_group_id_json}
    client_id: ${soc4kafka_client_id_json}
    # OCI Streaming speaks the Kafka 1.0 protocol (Metadata v5 / Fetch v6 max).
    # Without pinning this, franz-go (the kafkareceiver client) negotiates v7+
    # and loops on "max version 5 below the user defined min of 7", never
    # joining the consumer group.
    protocol_version: "1.0.0"
    logs:
      topics:
        - ${stream_name_json}
      encoding: ${soc4kafka_encoding_json}
    tls:
      insecure_skip_verify: false
    auth:
      sasl:
        mechanism: PLAIN
        username: ${streaming_sasl_username_json}
        password: ${streaming_auth_token_json}

processors:
  batch:
  resourcedetection:
    detectors: ["system"]
    system:
      hostname_sources: ["os"]

exporters:
  splunk_hec:
    token: ${splunk_hec_token_json}
    endpoint: ${splunk_hec_endpoint_json}
    index: ${splunk_hec_index_json}
    source: ${soc4kafka_source_json}
    sourcetype: ${soc4kafka_sourcetype_json}
    tls:
      insecure_skip_verify: false
    retry_on_failure:
      enabled: true
    sending_queue:
      enabled: true
      num_consumers: 10
      queue_size: 10000
      block_on_overflow: true
      sizer: items
      batch:
        min_size: 1000
        # Flush partial batches so low/idle volume still reaches HEC instead of
        # waiting indefinitely for min_size items.
        flush_timeout: 5s
    splunk_app_name: soc4kafka

service:
  pipelines:
    logs:
      receivers: [kafka]
      processors: [resourcedetection, batch]
      exporters: [splunk_hec]
